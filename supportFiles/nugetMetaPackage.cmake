###############################################################################
### CMake script to generate (and publish) a NuGet meta-package referencing all the RID specific packages of a native package
# The RID specific packages are the ones generated by the cmakeUtils NuGet helpers, named <PackageName>[-debug]-<RID>.
# The script searches the NuGet source for every known RID, selects the universal package of an OS (for example 'osx') when available and the architecture specific ones (for example 'osx-arm64' and 'osx-x64') otherwise, then generates a meta-package named <PackageName>[-debug] depending on all of them with an exact version.
# The meta-package also contains MSBuild targets keeping the layout of the native assets (subfolders of runtimes/<rid>/native/) in the consumer output folder.
#
# Usage: cmake -DMETA_PACKAGE_NAME=<name> -DNUGET_SOURCE=<source> -DWORK_FOLDER=<folder> [options] -P nugetMetaPackage.cmake
# Mandatory variables:
#  - META_PACKAGE_NAME: Base name of the packages (the PACKAGE_NAME given to the cmakeUtils NuGet helpers, usually the project name)
#  - NUGET_SOURCE: NuGet source URL to search the RID specific packages in and to push the meta-package to
#  - WORK_FOLDER: Absolute path of the temporary folder used to generate the meta-package (removed and recreated)
# Optional variables:
#  - NUGET_API_KEY: NuGet API key used to push the meta-package (credentials from the NuGet.config files are used otherwise)
#  - CONFIG_TYPE: Debug or Release (Default: Release), Debug adds the '-debug' suffix to all package IDs
#  - META_VERSION: Version of the meta-package, which must be published for at least one RID (Default: highest version found)
#  - SEARCH_FOLDER: Folder the NuGet.config files are searched from (Default: current folder)
#  - PUSH: Push the generated meta-package to the NuGet source (Default: ON)

cmake_minimum_required(VERSION 3.19)

set(BU_META_KNOWN_OSES "win" "linux" "osx" "ios" "android")
set(BU_META_KNOWN_ARCHS "x64" "x86" "arm64" "arm")

###############################################################################
# Compare two NuGet (SemVer 2.0) versions and set OUTPUT_VARIABLE to -1, 0 or 1
function(bu_meta_compare_versions LEFT RIGHT OUTPUT_VARIABLE)
	# Build metadata is not part of the version precedence
	string(REGEX REPLACE "\\+.*$" "" LEFT "${LEFT}")
	string(REGEX REPLACE "\\+.*$" "" RIGHT "${RIGHT}")
	string(REGEX MATCH "^([^-]+)(-(.*))?$" _ "${LEFT}")
	set(LEFT_CORE "${CMAKE_MATCH_1}")
	set(LEFT_LABEL "${CMAKE_MATCH_3}")
	string(REGEX MATCH "^([^-]+)(-(.*))?$" _ "${RIGHT}")
	set(RIGHT_CORE "${CMAKE_MATCH_1}")
	set(RIGHT_LABEL "${CMAKE_MATCH_3}")

	if(LEFT_CORE VERSION_LESS RIGHT_CORE)
		set(${OUTPUT_VARIABLE} -1 PARENT_SCOPE)
		return()
	elseif(LEFT_CORE VERSION_GREATER RIGHT_CORE)
		set(${OUTPUT_VARIABLE} 1 PARENT_SCOPE)
		return()
	endif()

	# A release version is greater than any prerelease version of the same core version
	if(LEFT_LABEL STREQUAL "" AND RIGHT_LABEL STREQUAL "")
		set(${OUTPUT_VARIABLE} 0 PARENT_SCOPE)
		return()
	elseif(LEFT_LABEL STREQUAL "")
		set(${OUTPUT_VARIABLE} 1 PARENT_SCOPE)
		return()
	elseif(RIGHT_LABEL STREQUAL "")
		set(${OUTPUT_VARIABLE} -1 PARENT_SCOPE)
		return()
	endif()

	# Compare the prerelease labels one by one: numeric labels numerically, alphanumeric labels case insensitively, and numeric labels are lower than alphanumeric ones
	string(TOLOWER "${LEFT_LABEL}" LEFT_LABEL)
	string(TOLOWER "${RIGHT_LABEL}" RIGHT_LABEL)
	string(REPLACE "." ";" LEFT_PARTS "${LEFT_LABEL}")
	string(REPLACE "." ";" RIGHT_PARTS "${RIGHT_LABEL}")
	list(LENGTH LEFT_PARTS LEFT_COUNT)
	list(LENGTH RIGHT_PARTS RIGHT_COUNT)
	set(INDEX 0)
	while(INDEX LESS LEFT_COUNT AND INDEX LESS RIGHT_COUNT)
		list(GET LEFT_PARTS ${INDEX} LEFT_PART)
		list(GET RIGHT_PARTS ${INDEX} RIGHT_PART)
		set(RESULT 0)
		if(LEFT_PART MATCHES "^[0-9]+$" AND RIGHT_PART MATCHES "^[0-9]+$")
			if(LEFT_PART LESS RIGHT_PART)
				set(RESULT -1)
			elseif(LEFT_PART GREATER RIGHT_PART)
				set(RESULT 1)
			endif()
		elseif(LEFT_PART MATCHES "^[0-9]+$")
			set(RESULT -1)
		elseif(RIGHT_PART MATCHES "^[0-9]+$")
			set(RESULT 1)
		elseif(LEFT_PART STRLESS RIGHT_PART)
			set(RESULT -1)
		elseif(LEFT_PART STRGREATER RIGHT_PART)
			set(RESULT 1)
		endif()
		if(NOT RESULT EQUAL 0)
			set(${OUTPUT_VARIABLE} ${RESULT} PARENT_SCOPE)
			return()
		endif()
		math(EXPR INDEX "${INDEX} + 1")
	endwhile()

	# All common labels are equal, the version with fewer labels is the lower one
	if(LEFT_COUNT LESS RIGHT_COUNT)
		set(${OUTPUT_VARIABLE} -1 PARENT_SCOPE)
	elseif(LEFT_COUNT GREATER RIGHT_COUNT)
		set(${OUTPUT_VARIABLE} 1 PARENT_SCOPE)
	else()
		set(${OUTPUT_VARIABLE} 0 PARENT_SCOPE)
	endif()
endfunction()

###############################################################################
# Search the NuGet source for all the published versions of PACKAGE_ID and set OUTPUT_VARIABLE to the list of versions (empty if the package does not exist)
function(bu_meta_search_package_versions PACKAGE_ID OUTPUT_VARIABLE)
	execute_process(
		COMMAND "${DOTNET_EXECUTABLE}" package search "${PACKAGE_ID}" --exact-match --prerelease --source "${NUGET_SOURCE}" --format json
		WORKING_DIRECTORY "${SEARCH_FOLDER}"
		OUTPUT_VARIABLE SEARCH_OUTPUT
		ERROR_VARIABLE SEARCH_ERROR
		RESULT_VARIABLE SEARCH_RESULT
	)
	if(NOT SEARCH_RESULT EQUAL 0)
		message(FATAL_ERROR "Failed to search package '${PACKAGE_ID}' in '${NUGET_SOURCE}':\n${SEARCH_OUTPUT}${SEARCH_ERROR}")
	endif()

	string(JSON PROBLEMS_COUNT ERROR_VARIABLE JSON_ERROR LENGTH "${SEARCH_OUTPUT}" "problems")
	if(JSON_ERROR)
		message(FATAL_ERROR "Unexpected search output for package '${PACKAGE_ID}':\n${SEARCH_OUTPUT}")
	endif()
	if(PROBLEMS_COUNT GREATER 0)
		math(EXPR LAST_PROBLEM "${PROBLEMS_COUNT} - 1")
		foreach(PROBLEM_INDEX RANGE ${LAST_PROBLEM})
			string(JSON PROBLEM_TYPE ERROR_VARIABLE JSON_ERROR GET "${SEARCH_OUTPUT}" "problems" ${PROBLEM_INDEX} "problemType")
			string(JSON PROBLEM_TEXT ERROR_VARIABLE JSON_ERROR GET "${SEARCH_OUTPUT}" "problems" ${PROBLEM_INDEX} "text")
			if(PROBLEM_TYPE STREQUAL "Error")
				message(FATAL_ERROR "Failed to search package '${PACKAGE_ID}' in '${NUGET_SOURCE}': ${PROBLEM_TEXT}")
			endif()
			message(WARNING "Searching package '${PACKAGE_ID}': ${PROBLEM_TEXT}")
		endforeach()
	endif()

	set(VERSIONS "")
	string(TOLOWER "${PACKAGE_ID}" PACKAGE_ID_LOWER)
	string(JSON SOURCES_COUNT LENGTH "${SEARCH_OUTPUT}" "searchResult")
	if(SOURCES_COUNT GREATER 0)
		math(EXPR LAST_SOURCE "${SOURCES_COUNT} - 1")
		foreach(SOURCE_INDEX RANGE ${LAST_SOURCE})
			string(JSON PACKAGES_COUNT LENGTH "${SEARCH_OUTPUT}" "searchResult" ${SOURCE_INDEX} "packages")
			if(PACKAGES_COUNT GREATER 0)
				math(EXPR LAST_PACKAGE "${PACKAGES_COUNT} - 1")
				foreach(PACKAGE_INDEX RANGE ${LAST_PACKAGE})
					string(JSON FOUND_ID GET "${SEARCH_OUTPUT}" "searchResult" ${SOURCE_INDEX} "packages" ${PACKAGE_INDEX} "id")
					string(JSON FOUND_VERSION GET "${SEARCH_OUTPUT}" "searchResult" ${SOURCE_INDEX} "packages" ${PACKAGE_INDEX} "version")
					string(TOLOWER "${FOUND_ID}" FOUND_ID_LOWER)
					if(FOUND_ID_LOWER STREQUAL PACKAGE_ID_LOWER)
						list(APPEND VERSIONS "${FOUND_VERSION}")
					endif()
				endforeach()
			endif()
		endforeach()
	endif()

	set(${OUTPUT_VARIABLE} "${VERSIONS}" PARENT_SCOPE)
endfunction()

###############################################################################
# Set OUTPUT_VARIABLE to TRUE if VERSION is in the VERSIONS list (using NuGet version equality), FALSE otherwise
function(bu_meta_has_version VERSIONS VERSION OUTPUT_VARIABLE)
	foreach(CANDIDATE IN LISTS VERSIONS)
		bu_meta_compare_versions("${CANDIDATE}" "${VERSION}" RESULT)
		if(RESULT EQUAL 0)
			set(${OUTPUT_VARIABLE} TRUE PARENT_SCOPE)
			return()
		endif()
	endforeach()
	set(${OUTPUT_VARIABLE} FALSE PARENT_SCOPE)
endfunction()

###############################################################################
# Set OUTPUT_VARIABLE to the content of the TAG element of the NUSPEC_CONTENT (kept XML escaped), empty if not found
function(bu_meta_get_nuspec_element NUSPEC_CONTENT TAG OUTPUT_VARIABLE)
	set(VALUE "")
	if(NUSPEC_CONTENT MATCHES "<${TAG}( [^>]*)?>([^<]*)</${TAG}>")
		set(VALUE "${CMAKE_MATCH_2}")
	endif()
	set(${OUTPUT_VARIABLE} "${VALUE}" PARENT_SCOPE)
endfunction()

###############################################################################
# Run a command from the WORKING_DIRECTORY folder, failing if it does not succeed
function(bu_meta_run_command DESCRIPTION WORKING_DIRECTORY)
	execute_process(
		COMMAND ${ARGN}
		WORKING_DIRECTORY "${WORKING_DIRECTORY}"
		RESULT_VARIABLE COMMAND_RESULT
	)
	if(NOT COMMAND_RESULT EQUAL 0)
		message(FATAL_ERROR "${DESCRIPTION} failed (exit code ${COMMAND_RESULT})")
	endif()
endfunction()

###############################################################################
# Check parameters
foreach(MANDATORY_VARIABLE META_PACKAGE_NAME NUGET_SOURCE WORK_FOLDER)
	if(NOT DEFINED ${MANDATORY_VARIABLE} OR "${${MANDATORY_VARIABLE}}" STREQUAL "")
		message(FATAL_ERROR "${MANDATORY_VARIABLE} variable is mandatory")
	endif()
endforeach()
file(TO_CMAKE_PATH "${WORK_FOLDER}" WORK_FOLDER)
string(REGEX REPLACE "(.)/$" "\\1" WORK_FOLDER "${WORK_FOLDER}")
if(NOT IS_ABSOLUTE "${WORK_FOLDER}")
	message(FATAL_ERROR "WORK_FOLDER must be an absolute path: ${WORK_FOLDER}")
endif()
if(NOT DEFINED CONFIG_TYPE OR CONFIG_TYPE STREQUAL "")
	set(CONFIG_TYPE "Release")
endif()
if(CONFIG_TYPE STREQUAL "Debug")
	set(PACKAGE_SUFFIX "-debug")
elseif(CONFIG_TYPE STREQUAL "Release")
	set(PACKAGE_SUFFIX "")
else()
	message(FATAL_ERROR "Unsupported CONFIG_TYPE '${CONFIG_TYPE}' (must be Debug or Release)")
endif()
if(NOT DEFINED SEARCH_FOLDER OR SEARCH_FOLDER STREQUAL "")
	set(SEARCH_FOLDER "${CMAKE_CURRENT_BINARY_DIR}")
endif()
file(TO_CMAKE_PATH "${SEARCH_FOLDER}" SEARCH_FOLDER)
if(NOT DEFINED PUSH)
	set(PUSH ON)
endif()

find_program(DOTNET_EXECUTABLE dotnet)
if(NOT DOTNET_EXECUTABLE)
	message(FATAL_ERROR "dotnet not found. Please add the .NET SDK folder in your PATH environment variable.")
endif()

set(META_PACKAGE_ID "${META_PACKAGE_NAME}${PACKAGE_SUFFIX}")

###############################################################################
# Search the published RID specific packages
message(STATUS "Searching '${META_PACKAGE_ID}-<rid>' packages in '${NUGET_SOURCE}'")
set(FOUND_RIDS "")
set(ALL_VERSIONS "")
foreach(OS IN LISTS BU_META_KNOWN_OSES)
	foreach(ARCH IN ITEMS "" LISTS BU_META_KNOWN_ARCHS)
		if(ARCH STREQUAL "")
			set(RID "${OS}")
		else()
			set(RID "${OS}-${ARCH}")
		endif()
		bu_meta_search_package_versions("${META_PACKAGE_ID}-${RID}" VERSIONS)
		if(VERSIONS)
			message(STATUS "  Found ${META_PACKAGE_ID}-${RID}: ${VERSIONS}")
			list(APPEND FOUND_RIDS "${RID}")
			set(VERSIONS_${RID} "${VERSIONS}")
			list(APPEND ALL_VERSIONS ${VERSIONS})
		endif()
	endforeach()
endforeach()
if(NOT FOUND_RIDS)
	message(FATAL_ERROR "No '${META_PACKAGE_ID}-<rid>' package found in '${NUGET_SOURCE}'")
endif()

# Use the highest published version unless specified
if(NOT DEFINED META_VERSION OR META_VERSION STREQUAL "")
	list(GET ALL_VERSIONS 0 META_VERSION)
	foreach(VERSION IN LISTS ALL_VERSIONS)
		bu_meta_compare_versions("${VERSION}" "${META_VERSION}" RESULT)
		if(RESULT GREATER 0)
			set(META_VERSION "${VERSION}")
		endif()
	endforeach()
endif()

# Select the packages to depend on, for each OS: the universal package if published with the version, the architecture specific ones otherwise
set(SELECTED_IDS "")
foreach(OS IN LISTS BU_META_KNOWN_OSES)
	set(OS_RIDS "")
	set(SKIPPED_RIDS "")
	if("${OS}" IN_LIST FOUND_RIDS)
		bu_meta_has_version("${VERSIONS_${OS}}" "${META_VERSION}" HAS_VERSION)
		if(HAS_VERSION)
			list(APPEND OS_RIDS "${OS}")
		else()
			list(APPEND SKIPPED_RIDS "${OS}")
		endif()
	endif()
	foreach(ARCH IN LISTS BU_META_KNOWN_ARCHS)
		set(RID "${OS}-${ARCH}")
		if("${RID}" IN_LIST FOUND_RIDS)
			bu_meta_has_version("${VERSIONS_${RID}}" "${META_VERSION}" HAS_VERSION)
			if(HAS_VERSION AND NOT "${OS}" IN_LIST OS_RIDS)
				list(APPEND OS_RIDS "${RID}")
			else()
				list(APPEND SKIPPED_RIDS "${RID}")
			endif()
		endif()
	endforeach()
	foreach(RID IN LISTS OS_RIDS)
		list(APPEND SELECTED_IDS "${META_PACKAGE_ID}-${RID}")
	endforeach()
	if(SKIPPED_RIDS)
		if(OS_RIDS)
			message(STATUS "Ignoring ${SKIPPED_RIDS} (version ${META_VERSION} not published, or universal '${OS}' package preferred)")
		else()
			message(WARNING "No ${OS} package published with version ${META_VERSION} (only other versions of ${SKIPPED_RIDS}), ${OS} will not be supported by the meta-package")
		endif()
	endif()
endforeach()
if(NOT SELECTED_IDS)
	message(FATAL_ERROR "No '${META_PACKAGE_ID}-<rid>' package found with version ${META_VERSION}")
endif()
message(STATUS "Meta-package ${META_PACKAGE_ID} ${META_VERSION} will depend on:")
foreach(PACKAGE_ID IN LISTS SELECTED_IDS)
	message(STATUS "  ${PACKAGE_ID} [${META_VERSION}]")
endforeach()

###############################################################################
# Generate an isolated project downloading the selected packages, which validates they can be restored and gives access to their metadata
file(REMOVE_RECURSE "${WORK_FOLDER}")
file(MAKE_DIRECTORY "${WORK_FOLDER}/package/buildTransitive")
# Empty MSBuild files stopping the lookup of the ones from the parent folders
file(WRITE "${WORK_FOLDER}/Directory.Build.props" "<Project />\n")
file(WRITE "${WORK_FOLDER}/Directory.Build.targets" "<Project />\n")
file(WRITE "${WORK_FOLDER}/Directory.Packages.props" "<Project />\n")

set(PACKAGE_DOWNLOADS "")
foreach(PACKAGE_ID IN LISTS SELECTED_IDS)
	string(APPEND PACKAGE_DOWNLOADS "\t\t<PackageDownload Include=\"${PACKAGE_ID}\" Version=\"[${META_VERSION}]\" />\n")
endforeach()
file(WRITE "${WORK_FOLDER}/MetaPackage.csproj"
	"<Project Sdk=\"Microsoft.NET.Sdk\">\n"
	"\t<PropertyGroup>\n"
	"\t\t<TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>\n"
	"\t\t<IncludeBuildOutput>false</IncludeBuildOutput>\n"
	"\t\t<NuspecFile>package/${META_PACKAGE_ID}.nuspec</NuspecFile>\n"
	"\t\t<NuspecBasePath>package</NuspecBasePath>\n"
	"\t\t<!-- Use the NuGet.config files of the search folder (sources, credentials, insecure connections), the work folder can be anywhere -->\n"
	"\t\t<RestoreRootConfigDirectory>${SEARCH_FOLDER}</RestoreRootConfigDirectory>\n"
	"\t</PropertyGroup>\n"
	"\t<ItemGroup>\n"
	"${PACKAGE_DOWNLOADS}"
	"\t</ItemGroup>\n"
	"</Project>\n"
)

message(STATUS "Restoring the selected packages")
bu_meta_run_command("Restoring the selected packages" "${WORK_FOLDER}" "${DOTNET_EXECUTABLE}" restore MetaPackage.csproj --source "${NUGET_SOURCE}")

# Get the metadata of the meta-package from the first selected package
file(READ "${WORK_FOLDER}/obj/project.assets.json" ASSETS_CONTENT)
string(JSON PACKAGES_FOLDER MEMBER "${ASSETS_CONTENT}" "packageFolders" 0)
string(REGEX REPLACE "[/\\\\]$" "" PACKAGES_FOLDER "${PACKAGES_FOLDER}")
list(GET SELECTED_IDS 0 REFERENCE_ID)
string(TOLOWER "${REFERENCE_ID}" REFERENCE_ID_LOWER)
string(TOLOWER "${META_VERSION}" META_VERSION_LOWER)
set(REFERENCE_NUSPEC "${PACKAGES_FOLDER}/${REFERENCE_ID_LOWER}/${META_VERSION_LOWER}/${REFERENCE_ID_LOWER}.nuspec")
if(NOT EXISTS "${REFERENCE_NUSPEC}")
	message(FATAL_ERROR "Restored package nuspec not found: ${REFERENCE_NUSPEC}")
endif()
file(READ "${REFERENCE_NUSPEC}" REFERENCE_NUSPEC_CONTENT)
bu_meta_get_nuspec_element("${REFERENCE_NUSPEC_CONTENT}" "authors" META_AUTHORS)
bu_meta_get_nuspec_element("${REFERENCE_NUSPEC_CONTENT}" "description" META_REFERENCE_DESCRIPTION)
bu_meta_get_nuspec_element("${REFERENCE_NUSPEC_CONTENT}" "copyright" META_COPYRIGHT)
bu_meta_get_nuspec_element("${REFERENCE_NUSPEC_CONTENT}" "projectUrl" META_PROJECT_URL)
if(META_AUTHORS STREQUAL "")
	set(META_AUTHORS "${META_PACKAGE_NAME}")
endif()

set(META_OPTIONAL_METADATA "")
if(NOT META_COPYRIGHT STREQUAL "")
	string(APPEND META_OPTIONAL_METADATA "\t\t<copyright>${META_COPYRIGHT}</copyright>\n")
endif()
if(NOT META_PROJECT_URL STREQUAL "")
	string(APPEND META_OPTIONAL_METADATA "\t\t<projectUrl>${META_PROJECT_URL}</projectUrl>\n")
endif()
if(REFERENCE_NUSPEC_CONTENT MATCHES "<license type=\"expression\">([^<]*)</license>")
	string(APPEND META_OPTIONAL_METADATA "\t\t<license type=\"expression\">${CMAKE_MATCH_1}</license>\n")
endif()
if(REFERENCE_NUSPEC_CONTENT MATCHES "<repository [^>]*url=\"([^\"]*)\"")
	set(REPOSITORY_URL "${CMAKE_MATCH_1}")
	set(REPOSITORY_TYPE "git")
	if(REFERENCE_NUSPEC_CONTENT MATCHES "<repository [^>]*type=\"([^\"]*)\"")
		set(REPOSITORY_TYPE "${CMAKE_MATCH_1}")
	endif()
	string(APPEND META_OPTIONAL_METADATA "\t\t<repository type=\"${REPOSITORY_TYPE}\" url=\"${REPOSITORY_URL}\" />\n")
endif()

###############################################################################
# Generate the meta-package content
set(META_DEPENDENCIES "")
set(META_RID_LIST "")
set(META_LOWER_IDS "")
foreach(PACKAGE_ID IN LISTS SELECTED_IDS)
	string(APPEND META_DEPENDENCIES "\t\t\t<dependency id=\"${PACKAGE_ID}\" version=\"[${META_VERSION}]\" />\n")
	string(REPLACE "${META_PACKAGE_ID}-" "" RID "${PACKAGE_ID}")
	string(APPEND META_RID_LIST "- `${RID}`: `${PACKAGE_ID}`\n")
	string(TOLOWER "${PACKAGE_ID}" PACKAGE_ID_LOWER)
	list(APPEND META_LOWER_IDS "${PACKAGE_ID_LOWER}")
endforeach()

set(META_DESCRIPTION "Meta-package referencing all the platform specific ${META_PACKAGE_ID}-&lt;rid&gt; packages.")
if(NOT META_REFERENCE_DESCRIPTION STREQUAL "")
	string(APPEND META_DESCRIPTION " ${META_REFERENCE_DESCRIPTION}")
endif()

file(WRITE "${WORK_FOLDER}/package/${META_PACKAGE_ID}.nuspec"
	"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
	"<package xmlns=\"http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd\">\n"
	"\t<metadata>\n"
	"\t\t<id>${META_PACKAGE_ID}</id>\n"
	"\t\t<version>${META_VERSION}</version>\n"
	"\t\t<authors>${META_AUTHORS}</authors>\n"
	"\t\t<description>${META_DESCRIPTION}</description>\n"
	"\t\t<readme>README.md</readme>\n"
	"${META_OPTIONAL_METADATA}"
	"\t\t<dependencies>\n"
	"${META_DEPENDENCIES}"
	"\t\t</dependencies>\n"
	"\t</metadata>\n"
	"\t<files>\n"
	"\t\t<file src=\"buildTransitive/${META_PACKAGE_ID}.targets\" target=\"buildTransitive/${META_PACKAGE_ID}.targets\" />\n"
	"\t\t<file src=\"README.md\" target=\"README.md\" />\n"
	"\t</files>\n"
	"</package>\n"
)

list(JOIN META_LOWER_IDS ";" BU_META_PACKAGE_IDS)
configure_file("${CMAKE_CURRENT_LIST_DIR}/nugetMetaPackage.targets.in" "${WORK_FOLDER}/package/buildTransitive/${META_PACKAGE_ID}.targets" @ONLY)

file(WRITE "${WORK_FOLDER}/package/README.md"
	"# ${META_PACKAGE_ID}\n"
	"\n"
	"Meta-package referencing the platform specific packages of `${META_PACKAGE_ID}` version `${META_VERSION}`, so a single `PackageReference` works on every supported platform:\n"
	"\n"
	"```xml\n"
	"<PackageReference Include=\"${META_PACKAGE_ID}\" Version=\"${META_VERSION}\" />\n"
	"```\n"
	"\n"
	"Supported runtime identifiers:\n"
	"\n"
	"${META_RID_LIST}"
	"\n"
	"The native assets are copied to the output folder keeping their layout (the subfolders of `runtimes/<rid>/native/`).\n"
	"Specifying a `RuntimeIdentifier` in the consumer project is recommended.\n"
	"Without it, the assets matching the machine running the build are copied to the output folder root, and the other ones are kept in `runtimes/<rid>/native/`.\n"
)

###############################################################################
# Pack and push the meta-package
message(STATUS "Packing ${META_PACKAGE_ID} ${META_VERSION}")
bu_meta_run_command("Packing the meta-package" "${WORK_FOLDER}" "${DOTNET_EXECUTABLE}" pack MetaPackage.csproj --no-restore -p:NoBuild=true --output "${WORK_FOLDER}/output")
set(META_PACKAGE_FILE "${WORK_FOLDER}/output/${META_PACKAGE_ID}.${META_VERSION}.nupkg")
if(NOT EXISTS "${META_PACKAGE_FILE}")
	message(FATAL_ERROR "Generated meta-package not found: ${META_PACKAGE_FILE}")
endif()

if(PUSH)
	message(STATUS "Pushing ${META_PACKAGE_ID} ${META_VERSION} to '${NUGET_SOURCE}'")
	set(PUSH_COMMAND "${DOTNET_EXECUTABLE}" nuget push "${META_PACKAGE_FILE}" --source "${NUGET_SOURCE}")
	if(DEFINED NUGET_API_KEY AND NOT NUGET_API_KEY STREQUAL "")
		list(APPEND PUSH_COMMAND --api-key "${NUGET_API_KEY}")
	endif()
	bu_meta_run_command("Pushing the meta-package" "${SEARCH_FOLDER}" ${PUSH_COMMAND})
else()
	message(STATUS "Meta-package generated (not pushed): ${META_PACKAGE_FILE}")
endif()
