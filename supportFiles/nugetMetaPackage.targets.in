<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by the bashUtils nugetMetaPackage.cmake script, imported by the projects referencing the meta-package (directly or transitively). -->
<Project>

	<PropertyGroup>
		<!-- Lowercase IDs of the RID specific packages whose native assets must keep their layout, shared by all the meta-packages generated by the script. -->
		<LaNativeRuntimePackageIds>$(LaNativeRuntimePackageIds);@BU_META_PACKAGE_IDS@</LaNativeRuntimePackageIds>
	</PropertyGroup>

	<!-- Defined by all the meta-packages generated by the script with the same content, so the last imported definition is the one used. -->
	<!-- The SDK flattens the runtimes/<rid>/native/** assets into the output folder root when a RuntimeIdentifier is set, and copies them to runtimes/<rid>/native/** otherwise. -->
	<!-- Keep the layout of the native assets (for example plugins/<name>/...) relative to the output folder root instead, for the assets matching the RuntimeIdentifier, or the machine running the build when no RuntimeIdentifier is set. -->
	<Target Name="LaKeepNativeRuntimeLayout" AfterTargets="ResolvePackageAssets">
		<PropertyGroup>
			<_LaNativeRuntimePackageIds>;$(LaNativeRuntimePackageIds.ToLowerInvariant());</_LaNativeRuntimePackageIds>
			<_LaHostRuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</_LaHostRuntimeIdentifier>
			<_LaHostRuntimeIdentifier Condition="'$(_LaHostRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_LaHostRuntimeIdentifier>
			<_LaHostOperatingSystem>$(_LaHostRuntimeIdentifier.Substring(0, $(_LaHostRuntimeIdentifier.LastIndexOf('-'))))</_LaHostOperatingSystem>
		</PropertyGroup>
		<ItemGroup>
			<NativeCopyLocalItems Condition="$(_LaNativeRuntimePackageIds.Contains(';$([System.String]::Copy(&quot;%(NativeCopyLocalItems.NuGetPackageId)&quot;).ToLowerInvariant());'))">
				<DestinationSubDirectory>$([System.Text.RegularExpressions.Regex]::Replace('%(NativeCopyLocalItems.PathInPackage)', '^runtimes/[^/]+/native/((?:.*/)?)[^/]*$', '$1'))</DestinationSubDirectory>
			</NativeCopyLocalItems>
			<RuntimeTargetsCopyLocalItems Condition="'$(RuntimeIdentifier)' == '' And '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' And ('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(_LaHostRuntimeIdentifier)' Or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(_LaHostOperatingSystem)') And $(_LaNativeRuntimePackageIds.Contains(';$([System.String]::Copy(&quot;%(RuntimeTargetsCopyLocalItems.NuGetPackageId)&quot;).ToLowerInvariant());'))">
				<DestinationSubDirectory>$([System.Text.RegularExpressions.Regex]::Replace('%(RuntimeTargetsCopyLocalItems.PathInPackage)', '^runtimes/[^/]+/native/((?:.*/)?)[^/]*$', '$1'))</DestinationSubDirectory>
			</RuntimeTargetsCopyLocalItems>
		</ItemGroup>
	</Target>

</Project>
