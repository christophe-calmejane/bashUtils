<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by the bashUtils nugetMetaPackage.cmake script, imported by the projects referencing the @BU_META_PACKAGE_ID@ meta-package (directly or transitively). -->
<Project>

	<!-- The SDK flattens the runtimes/<rid>/native/** assets into the output folder root when a RuntimeIdentifier is set (only for the packages of this exact RID), and copies them to runtimes/<rid>/native/** otherwise. -->
	<!-- Copy instead the native assets of the single package best matching the RuntimeIdentifier (or the machine running the build when none is set) to the output folder root, keeping their layout (for example plugins/<name>/...). -->
	<!-- The selected package is the one of the exact RID, else the universal one of the operating system, else the x64 one on Windows and macOS arm64 (which run x64 binaries through emulation). -->
	<Target Name="LaSelectNativeRuntime_@BU_META_TARGET_SUFFIX@" AfterTargets="ResolvePackageAssets">
		<PropertyGroup>
			<_LaAvailableRids>;@BU_META_RIDS@;</_LaAvailableRids>
			<_LaPackageIds>;@BU_META_PACKAGE_IDS@;</_LaPackageIds>
			<_LaTargetRid>$(RuntimeIdentifier)</_LaTargetRid>
			<_LaTargetRid Condition="'$(_LaTargetRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_LaTargetRid>
			<_LaTargetRid Condition="'$(_LaTargetRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_LaTargetRid>
			<_LaTargetRid>$(_LaTargetRid.ToLowerInvariant())</_LaTargetRid>
			<_LaTargetOs>$(_LaTargetRid)</_LaTargetOs>
			<_LaTargetOs Condition="$(_LaTargetRid.Contains('-'))">$(_LaTargetRid.Substring(0, $(_LaTargetRid.LastIndexOf('-'))))</_LaTargetOs>
			<_LaTargetArch></_LaTargetArch>
			<_LaTargetArch Condition="$(_LaTargetRid.Contains('-'))">$(_LaTargetRid.Substring($([MSBuild]::Add($(_LaTargetRid.LastIndexOf('-')), 1))))</_LaTargetArch>
			<_LaSelectedRid></_LaSelectedRid>
			<_LaSelectedRid Condition="$(_LaAvailableRids.Contains(';$(_LaTargetRid);'))">$(_LaTargetRid)</_LaSelectedRid>
			<_LaSelectedRid Condition="'$(_LaSelectedRid)' == '' And $(_LaAvailableRids.Contains(';$(_LaTargetOs);'))">$(_LaTargetOs)</_LaSelectedRid>
			<_LaSelectedRid Condition="'$(_LaSelectedRid)' == '' And '$(_LaTargetArch)' == 'arm64' And ('$(_LaTargetOs)' == 'win' Or '$(_LaTargetOs)' == 'osx') And $(_LaAvailableRids.Contains(';$(_LaTargetOs)-x64;'))">$(_LaTargetOs)-x64</_LaSelectedRid>
			<_LaNativeFolder>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))@BU_META_PACKAGE_ID_LOWER@-$(_LaSelectedRid)/@BU_META_VERSION_LOWER@/runtimes/$(_LaSelectedRid)/native/</_LaNativeFolder>
		</PropertyGroup>

		<Warning Condition="'$(_LaSelectedRid)' == ''" Code="LANUGET001" Text="@BU_META_PACKAGE_ID@ @BU_META_VERSION@ provides no native package usable on '$(_LaTargetRid)' (available: @BU_META_RIDS@)" />

		<ItemGroup>
			<NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$(_LaPackageIds.Contains(';$([System.String]::Copy(&quot;%(NativeCopyLocalItems.NuGetPackageId)&quot;).ToLowerInvariant());'))" />
			<RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$(_LaPackageIds.Contains(';$([System.String]::Copy(&quot;%(RuntimeTargetsCopyLocalItems.NuGetPackageId)&quot;).ToLowerInvariant());'))" />
			<_LaNativeAssets Include="$(_LaNativeFolder)**" Condition="'$(_LaSelectedRid)' != ''" />
			<NativeCopyLocalItems Include="@(_LaNativeAssets)">
				<AssetType>native</AssetType>
				<CopyLocal>true</CopyLocal>
				<DestinationSubDirectory>%(_LaNativeAssets.RecursiveDir)</DestinationSubDirectory>
				<DestinationSubPath>%(_LaNativeAssets.RecursiveDir)%(_LaNativeAssets.Filename)%(_LaNativeAssets.Extension)</DestinationSubPath>
				<NuGetPackageId>@BU_META_PACKAGE_ID@-$(_LaSelectedRid)</NuGetPackageId>
				<NuGetPackageVersion>@BU_META_VERSION@</NuGetPackageVersion>
				<RuntimeIdentifier>$(_LaSelectedRid)</RuntimeIdentifier>
			</NativeCopyLocalItems>
			<_LaNativeAssets Remove="@(_LaNativeAssets)" />
		</ItemGroup>
	</Target>

</Project>
