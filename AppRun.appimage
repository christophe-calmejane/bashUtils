#!/bin/bash
# Generic AppRun for persistent AppImage installation
# Handles:
#   - Persistent installation to ~/.local/share/<AppName>/
#   - RPATH rewriting (replaces $ORIGIN with absolute paths for AT_SECURE compatibility)
#   - File capabilities via setcap (optional, one-time setup)
#   - Desktop integration (application menu entry with icon)
#
# Configuration is read from .appimage_config (generated at build time by gen_appimage.sh).
# The .desktop file is also generated at build time and copied at install time.
#
# Library loading: Under AT_SECURE (triggered by setcap file capabilities), the dynamic
# linker rejects $ORIGIN in DT_RPATH/DT_RUNPATH. To handle this, patchelf is used at
# install time to rewrite all RPATHs to absolute paths. This avoids polluting the system
# library cache (ldconfig) while keeping libraries self-contained and isolated from
# system-installed versions.
#
# Flow:
#   First launch  -> extract to persistent dir, rewrite RPATHs, apply capabilities, create desktop entry
#   Next launches -> run directly from persistent install (skips setup entirely)
#   New version   -> detect version mismatch, re-extract and re-setup

HERE="${APPDIR:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"

# Load configuration generated by gen_appimage.sh
if [ ! -f "${HERE}/.appimage_config" ]; then
	echo "ERROR: Missing .appimage_config in AppImage"
	exit 1
fi
. "${HERE}/.appimage_config"

INSTALL_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/${APP_NAME}"
VERSION_FILE="${INSTALL_DIR}/.appimage_version"

# Read embedded version
CURRENT_VERSION=""
if [ -f "${HERE}/.appimage_version" ]; then
	CURRENT_VERSION=$(cat "${HERE}/.appimage_version")
fi

# Check if persistent install is needed (first run or version update)
needs_install=0
if [ ! -x "${INSTALL_DIR}/${APP_BINARY}" ]; then
	needs_install=1
elif [ "$(cat "${VERSION_FILE}" 2>/dev/null)" != "${CURRENT_VERSION}" ]; then
	needs_install=1
fi

if [ $needs_install -eq 1 ]; then
	echo "Installing ${APP_NAME}..."
	rm -rf "${INSTALL_DIR}"
	mkdir -p "${INSTALL_DIR}"
	cp -a "${HERE}/usr" "${INSTALL_DIR}/"
	cp -f "${HERE}/.appimage_config" "${INSTALL_DIR}/"
	echo "${CURRENT_VERSION}" > "${INSTALL_DIR}/.appimage_version"

	# --- Rewrite RPATHs from $ORIGIN to absolute paths ---
	# Under AT_SECURE (triggered by setcap), the dynamic linker rejects $ORIGIN in
	# DT_RPATH/DT_RUNPATH. We rewrite all RPATHs to use absolute paths so that library
	# resolution works regardless of whether capabilities are set.
	# Prefer system patchelf if available, fallback to bundled one.
	patchelf_bin=""
	if command -v patchelf &>/dev/null; then
		patchelf_bin="patchelf"
	elif [ -x "${INSTALL_DIR}/usr/bin/patchelf" ]; then
		patchelf_bin="${INSTALL_DIR}/usr/bin/patchelf"
	fi
	if [ -n "${patchelf_bin}" ]; then
		while IFS= read -r -d '' elf; do
			if file "$elf" | grep -q "ELF"; then
				cur_rpath=$("${patchelf_bin}" --print-rpath "$elf" 2>/dev/null)
				if [ -n "$cur_rpath" ]; then
					elf_dir=$(dirname "$elf")
					new_rpath="${cur_rpath//\$ORIGIN/$elf_dir}"
					"${patchelf_bin}" --set-rpath "$new_rpath" "$elf" 2>/dev/null
				fi
			fi
		done < <(find "${INSTALL_DIR}/usr" -type f \( -name "*.so*" -o -executable \) -print0)
	fi

	# --- Desktop integration ---
	desktop_dir="${HOME}/.local/share/applications"
	icon_dir="${HOME}/.local/share/icons/hicolor/256x256/apps"
	mkdir -p "${desktop_dir}" "${icon_dir}"

	# Copy .desktop from AppDir and rewrite Exec= to point to the launcher script
	src_desktop=$(find "${HERE}/usr/share/applications" -name "*.desktop" -type f 2>/dev/null | head -1)
	if [ -n "${src_desktop}" ]; then
		sed "s|^Exec=.*|Exec=${INSTALL_DIR}/launch.sh %F|" "${src_desktop}" > "${desktop_dir}/${APP_NAME}.desktop"
		chmod +x "${desktop_dir}/${APP_NAME}.desktop"
		command -v update-desktop-database &>/dev/null && update-desktop-database "${desktop_dir}" 2>/dev/null
	fi

	# Copy icon
	icon_source=$(find "${HERE}/usr/share/icons" -name "${APP_NAME}.png" -type f 2>/dev/null | head -1)
	if [ -z "${icon_source}" ] && [ -f "${HERE}/${APP_NAME}.png" ]; then
		icon_source="${HERE}/${APP_NAME}.png"
	fi
	if [ -n "${icon_source}" ]; then
		cp -f "${icon_source}" "${icon_dir}/${APP_NAME}.png"
	fi

	# Create launcher script (used by .desktop file and as the main entry point)
	cat > "${INSTALL_DIR}/launch.sh" << 'LAUNCHER_EOF'
#!/bin/bash
SELF_DIR="$(dirname "$(readlink -f "$0")")"
. "${SELF_DIR}/.appimage_config"
exec "${SELF_DIR}/${APP_BINARY}" "$@"
LAUNCHER_EOF
	chmod +x "${INSTALL_DIR}/launch.sh"

	# --- File capabilities (optional) ---
	if [ -n "${SETCAP_CAPABILITY}" ]; then
		echo ""
		echo "${APP_NAME} needs elevated capabilities to run properly."
		echo "You will be prompted for your administrator password (one-time setup)."
		echo "If you skip this step, ${APP_NAME} will still run but with reduced functionality."
		echo ""

		setup_ok=0
		if command -v pkexec &>/dev/null; then
			pkexec setcap "${SETCAP_CAPABILITY}" "${INSTALL_DIR}/${APP_BINARY}" 2>/dev/null && setup_ok=1
		elif [ -t 0 ]; then
			sudo setcap "${SETCAP_CAPABILITY}" "${INSTALL_DIR}/${APP_BINARY}" 2>/dev/null && setup_ok=1
		fi

		if [ $setup_ok -eq 1 ]; then
			echo "Setup complete. ${APP_NAME} is now available in your application menu."
		else
			echo "Capability setup was skipped or failed."
			echo "${APP_NAME} will run with reduced functionality."
			echo ""
			echo "To set capabilities later, run:"
			echo "  sudo setcap ${SETCAP_CAPABILITY} \"${INSTALL_DIR}/${APP_BINARY}\""
		fi
		echo ""
	else
		echo "${APP_NAME} is now available in your application menu."
	fi
fi

# Launch from the persistent install
exec "${INSTALL_DIR}/launch.sh" "$@"
